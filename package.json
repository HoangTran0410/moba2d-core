{
  "name": "@moba2d/core",
  "version": "1.8.0",
  "type": "module",
  "workspaces": [
    ".",
    "packs/*"
  ],
  "exports": {
    "./content/ContentApi": "./src/content/ContentApi.ts",
    "./content/ContentPack": "./src/content/ContentPack.ts",
    "./content/types": "./src/content/types.ts",
    "./seams": "./src/seams/index.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./types/global.d.ts": "./src/types/global.d.ts",
    "./types/poly-decomp.d.ts": "./src/types/poly-decomp.d.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/spell": "./src/testing/spellWorld.ts",
    "./testing/spells": "./src/testing/spellRegistry.ts",
    "./testing/vitest": "./src/testing/vitest.mjs",
    "./testing/setup": "./src/testing/setup.ts",
    "./package.json": "./package.json",
    "./pack-assets": "./scripts/generate-assets.mjs",
    "./pack-webp": "./scripts/pack-webp.mjs"
  },
  "bin": {
    "moba2d-check-seams": "./scripts/check-seams.mjs",
    "moba2d-generate-spell-catalog": "./scripts/generate-spell-catalog.mjs",
    "moba2d-pack-new": "./scripts/pack-new.mjs",
    "moba2d-pack-add": "./scripts/pack-add.mjs",
    "moba2d-pack-serve": "./scripts/pack-serve.mjs",
    "moba2d-generate-assets": "./scripts/pack-assets.mjs"
  },
  "files": [
    "assets/cursors",
    "assets/images",
    "packs/reference",
    "public",
    "scripts/check-seams.mjs",
    "scripts/generate-spell-catalog.mjs",
    "scripts/pack-webp.mjs",
    "scripts/pack-assets.mjs",
    "scripts/generate-assets.mjs",
    "scripts/installed-packs.mjs",
    "scripts/pack-new.mjs",
    "scripts/pack-add.mjs",
    "scripts/pack-serve.mjs",
    "scripts/lib/packRoot.mjs",
    "scripts/templates",
    "scripts/version.mjs",
    "scripts/vite/restart-on-version-change.mjs",
    "src",
    "styles",
    "index.html",
    "tsconfig.base.json",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "scripts": {
    "packs:generate": "node scripts/generate-installed-packs.mjs",
    "packs:check": "node scripts/generate-installed-packs.mjs --check",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:check": "node scripts/generate-assets.mjs --check",
    "catalog:generate": "node scripts/generate-spell-catalog.mjs",
    "catalog:check": "node scripts/generate-spell-catalog.mjs --check",
    "contract:bump": "node scripts/bump-api-contract.mjs",
    "pack:new": "node scripts/pack-new.mjs",
    "pack:link": "node scripts/pack-link.mjs",
    "links:check": "node scripts/pack-link.mjs --check",
    "pack:unlink": "node scripts/pack-link.mjs --unlink",
    "alias:migrate": "node scripts/migrate-to-alias.mjs",
    "predev": "npm run packs:generate && npm run assets:generate && npm run catalog:generate && npm run vendor:copy",
    "dev": "vite",
    "prebuild": "npm run packs:generate && npm run assets:generate && npm run catalog:generate && npm run vendor:copy",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.strict-core.json",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "verify": "npm run links:check && npm run packs:check && npm run assets:check && npm run catalog:check && npm run typecheck && npm run typecheck:core && npm run typecheck:sw && npm run test:all && npm run build && npm run chunks:check && npm run check-seams",
    "verify:all": "npm run verify && npm run check-seams --workspace=@moba2d/content-reference",
    "e2e": "node tests/e2e/drive-game.mjs",
    "e2e:hud": "node tests/e2e/hud-mana.mjs",
    "e2e:shop": "node tests/e2e/drive-shop-hud.mjs",
    "e2e:inventory": "node tests/e2e/drive-inventory-drag.mjs /tmp/invdrag",
    "e2e:shop-touch": "node tests/e2e/drive-shop-touch.mjs",
    "e2e:camps": "node tests/e2e/verify-camp-spread.mjs",
    "e2e:lan": "node tests/e2e/drive-lan-sync.mjs",
    "e2e:attacks": "node tests/e2e/drive-basic-attacks.mjs",
    "vendor:copy": "node scripts/copy-vendor.mjs",
    "chunks:check": "node scripts/check-chunks.mjs",
    "check-seams": "moba2d-check-seams ./src/game/gameObject/coreSpells && moba2d-check-seams ./src/game/gameObject/spellObjects && moba2d-check-seams ./src/game/gameObject/buffs && moba2d-check-seams ./src/game/gameObject/attackableUnits",
    "version:show": "node scripts/version.mjs",
    "e2e:pwa": "npm run build && node tests/e2e/verify-pwa-offline.mjs",
    "e2e:pwa-update": "node tests/e2e/measure-pwa-update-latency.mjs",
    "e2e:champions": "node tests/e2e/smoke-new-champions.mjs",
    "e2e:vfx": "node tests/e2e/shoot-new-champion-vfx.mjs",
    "e2e:bots": "node tests/e2e/drive-bot-discipline.mjs",
    "e2e:render": "node tests/e2e/verify-render-guard.mjs",
    "e2e:update": "node tests/e2e/verify-update-guard.mjs",
    "e2e:crash-report": "node tests/e2e/verify-global-error-overlay.mjs",
    "e2e:pack": "node tests/e2e/verify-pack-champion.mjs",
    "e2e:map-picker": "node tests/e2e/verify-map-picker.mjs",
    "e2e:core-alone": "node tests/e2e/verify-core-alone.mjs",
    "e2e:runtime-pack": "node tests/e2e/verify-runtime-pack.mjs",
    "e2e:packs": "node tests/e2e/verify-pack-management.mjs",
    "icons:render": "node scripts/render-icons.mjs",
    "icons:check": "node scripts/render-icons.mjs --check",
    "e2e:icons": "node tests/e2e/verify-icon-assets.mjs",
    "e2e:pack-failures": "node tests/e2e/verify-pack-failure-paths.mjs",
    "e2e:stale": "node tests/e2e/verify-pack-staleness.mjs",
    "e2e:chunk-cascade": "node scripts/measure-chunk-cascade.mjs",
    "verify:without-packs": "node scripts/verify-without-packs.mjs",
    "verify:pack-standalone": "node scripts/verify-pack-standalone.mjs"
  },
  "dependencies": {
    "detect-collisions": "^9.2.2",
    "p5": "^1.9.4",
    "poly-decomp": "^0.3.0",
    "sat": "^0.9.0",
    "uuid": "^9.0.1",
    "visibility-polygon": "^1.0.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/p5": "^1.7.6",
    "@types/sat": "^0.0.35",
    "@vitejs/plugin-vue": "^5.2.4",
    "luaparse": "0.3.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.2.12",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "vitest": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
