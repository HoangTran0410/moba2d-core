#!/bin/sh
# Pre-push gate: `npm run verify` must pass before anything leaves this machine.
#
# Versioned here rather than living only in .git/hooks so a fresh clone gets it
# back with one command: `npm run hooks:install` (points core.hooksPath here).
#
# Escape hatches:
#   git push --no-verify           # skip once, on purpose
#   MOBA2D_SKIP_VERIFY=1 git push  # same, for scripts
#
# While a pack is linked for development, verify cannot run at all (links:check
# refuses, and four test files are red under any link by design) — but the link
# lives in the working tree, not in history, so that alone is no reason to
# block a push. What must never leave is a *commit* with the link baked in: a
# committed src/generated/installedPacks.ts naming a dev-linked pack is an
# import that resolves for nobody else. So: unlinked pushes get the full gate;
# linked pushes get each outgoing commit checked for exactly that poison, a
# warning that the test suite did not run, and passage.

[ "$MOBA2D_SKIP_VERIFY" = "1" ] && exit 0

# stdin: one "<local ref> <local sha> <remote ref> <remote sha>" line per ref.
# A push that only deletes remote refs (local sha all zeros) verifies nothing.
zero=0000000000000000000000000000000000000000
pairs=
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  pairs="$pairs $local_sha:$remote_sha"
done
[ -n "$pairs" ] || exit 0

# The performance guard, ahead of the linked/not-linked split below because
# whether a pack is linked has nothing to do with whether this push adds a
# spell that eats the frame. It looks only at the spell files the push adds
# and exits in milliseconds when there are none.
#   MOBA2D_PERF_GUARD_SKIP=1 git push   # bypass, on purpose
if [ -f "scripts/perf-guard.mjs" ]; then
  node scripts/perf-guard.mjs --repo "$(pwd)" || exit 1
fi

if npm run --silent links:check >/dev/null 2>&1; then
  # Not linked: the full gate.
  echo "pre-push: running npm run verify (git push --no-verify skips this once)"
  npm run verify && exit 0

  echo ""
  echo "pre-push: verify FAILED — push blocked."
  echo "  skip once on purpose: git push --no-verify"
  exit 1
fi

# Linked for development. Check every outgoing commit (just the tip when the
# remote side is new and there is no range to ask for) for a committed dev
# link, and let a clean push through.
for pair in $pairs; do
  local_sha=${pair%:*}
  remote_sha=${pair#*:}
  if [ "$remote_sha" = "$zero" ]; then
    commits=$local_sha
  else
    commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null) || commits=$local_sha
  fi
  for sha in $commits; do
    if git show "$sha:src/generated/installedPacks.ts" 2>/dev/null | grep -q 'linked: true'; then
      echo "pre-push: commit $sha carries src/generated/installedPacks.ts with a dev-linked"
      echo "  pack in it — that import resolves on no machine but this one. Push blocked."
      echo "  Fix: npm run pack:unlink -- --all, commit the regenerated file (or amend), re-link."
      exit 1
    fi
  done
done

echo "pre-push: a pack is linked for development, so the verify suite cannot run —"
echo "  outgoing commits carry no dev link, letting the push through unverified."
echo "  For the full gate: npm run pack:unlink -- --all, push again, then re-link."
exit 0
