import type { ContentApi } from '@moba2d/core/content/ContentApi';

/**
 * Builds a class from the injected `api`, once per `api`.
 *
 * Every class in a pack has to be a factory rather than a plain
 * `export class X extends Spell`, because a pack may not value-import core —
 * `Spell`, `SpellObject` and the rest arrive on `api`, and a class body
 * cannot extend something it has not been handed yet. That part is the
 * boundary, not a preference (`npm run check-seams`, rule
 * `pack-core-boundary`).
 *
 * The memo is the second half, and the less obvious one: the real game, an
 * e2e script and a test each build their own `ContentApi`, so a bare
 * `api => class X ...` hands two callers two different classes with the same
 * name and every `instanceof` between them answers false. Keyed on the `api`
 * itself, in a `WeakMap`, so a discarded api takes its classes with it.
 *
 * Written out by hand, this is three top-level declarations per class — a
 * `__build`, a `__cache` and a `make` — and a pack with 200 abilities carries
 * a few thousand lines of it. Which is why it is one line here instead:
 *
 *   export default packClass(api => class __CHAMPION___Q extends api.Spell { ... });
 *
 * It imports nothing of core but a type, so it costs this pack nothing at
 * runtime and stays this pack's own to change.
 */
export function packClass<T>(build: (api: ContentApi) => T): (api: ContentApi) => T {
  const cache = new WeakMap<ContentApi, T>();
  return (api: ContentApi): T => {
    const cached = cache.get(api);
    if (cached) return cached;
    const built = build(api);
    cache.set(api, built);
    return built;
  };
}

/**
 * The instance type of a class this pack builds — `Instance<typeof makeX>`.
 *
 * `packClass` returns a *factory*, so naming what it eventually constructs
 * takes two unwrappings: `InstanceType<ReturnType<typeof makeX>>`. A file
 * that defines a spell, its missile and its buff writes that three times
 * before its first line of content.
 *
 * Only for this pack's own classes. A core class — `AttackableUnit`,
 * `Spell`, `Slow` — has a published name already:
 *
 *     import type { AttackableUnit, Slow } from '@moba2d/core/content/types';
 */
export type Instance<F extends (api: ContentApi) => abstract new (...args: never[]) => unknown> =
  InstanceType<ReturnType<F>>;
