/**
 * This pack's own art, under this pack's own keys.
 *
 * Core registers it as `__PACK_ID__`'s manifest and resolves `api.asset(key)`
 * against it — never against core's, which is the `pack-asset-key` seam
 * `npm run check-seams` enforces: reusing a key that happens to exist in
 * core's art (`buff_slow` and friends excepted, which are core mechanics'
 * own icons) is a pack that draws the engine's pictures.
 *
 * The one entry below is a **placeholder tile**, inlined as a data URI so
 * this scaffold ships a working art path without shipping anyone's artwork.
 * Real art is a file, and the line for it is:
 *
 *   import heroPortrait from './assets/champ_hero.png?url';
 *
 * `?url` (Vite's own syntax, typed by `vite/client` in `tsconfig.json`)
 * hands back the emitted file's URL rather than its bytes, which is what
 * keeps `vite.config.ts`'s `assetsInlineLimit: 0` meaningful: art lands in
 * `dist/assets/` as real files, and `pack.js` — downloaded before the menu
 * can draw — carries none of it.
 *
 * A pack with more than a handful of images generates this file instead of
 * writing it; core's own `scripts/generate-assets.mjs` is the worked
 * example, and `.gitignore` already ignores a `generated/` directory for it.
 */
const heroPortrait =
  'data:image/png;base64,';

export const assetManifest = {
  champ_hero: { kind: 'image', url: heroPortrait, path: 'assets/champ_hero.png' },
} as const;
