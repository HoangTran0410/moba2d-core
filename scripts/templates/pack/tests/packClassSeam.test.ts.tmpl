import { readdirSync, readFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { describe, expect, it } from 'vitest';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');

/**
 * `packClass` is the only per-`api` memo in this pack.
 *
 * Every class here is built from the injected `api` — a pack may not
 * value-import core — and has to be memoized on it, or two callers with two
 * `ContentApi`s get two `instanceof`-incompatible classes with the same name.
 * Written out by hand that is a `__build`, a `__cache` WeakMap and a `make`
 * per class; `packClass.ts` is the eight lines that hold it once.
 *
 * This scan exists because the pack that first did this collapsed 650 of them
 * and still missed four. Those four used a *second* naming convention for a
 * set of classes that reference each other and must be built together
 * (`__group0_XBuild` / `__group0_XCache`), and the cleanup's leftover check
 * was looking for `__build` and `__cache` — which match neither. A scan keyed
 * on a **name** can always be defeated by a new name.
 *
 * So this one is keyed on the thing itself: a `WeakMap` keyed by `ContentApi`
 * is what a per-api memo *is*, whatever its author called it.
 */
function tsFilesUnder(dir: string): string[] {
  const found: string[] = [];
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (entry.name === 'node_modules' || entry.name === 'dist') continue;
    const full = join(dir, entry.name);
    if (entry.isDirectory()) found.push(...tsFilesUnder(full));
    else if (entry.name.endsWith('.ts')) found.push(full);
  }
  return found;
}

const stripComments = (source: string): string =>
  source.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '');

describe('the per-api memo', () => {
  it('lives in packClass.ts and nowhere else', () => {
    const files = tsFilesUnder(root);
    // A walker that found nothing would pass against nothing.
    expect(files.length).toBeGreaterThan(3);

    const offenders = files
      .filter(file => file !== join(root, 'packClass.ts'))
      .filter(file => /new WeakMap<\s*ContentApi\s*,/.test(stripComments(readFileSync(file, 'utf8'))))
      .map(file => file.slice(root.length + 1));

    expect(
      offenders,
      'a hand-rolled per-api memo — wrap the builder in `packClass` from ../packClass instead'
    ).toEqual([]);
  });
});
